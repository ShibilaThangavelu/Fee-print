# Copy to backend/.env and fill in.

# OAuth 2.0 "Web application" client ID from Google Cloud Console
# (APIs & Services -> Credentials). Leave blank to run without Google sign-in.
GOOGLE_CLIENT_ID=

# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Set to true only when served over HTTPS.
COOKIE_SECURE=false

# Gemini API key (fallback extractor). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sentry (error tracking). Leave blank to run without it.
SENTRY_DSN=
FEEPRINT_ENV=local
