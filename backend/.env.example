# Copy to backend/.env and fill in.

# OAuth 2.0 "Web application" client ID from Google Cloud Console
# (APIs & Services -> Credentials). Leave blank to run without Google sign-in.
GOOGLE_CLIENT_ID=

# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Set to true only when served over HTTPS.
COOKIE_SECURE=false
